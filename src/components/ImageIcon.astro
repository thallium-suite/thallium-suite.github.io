---
/**
 * Inline SVG icon set for the image catalogue.
 * Stroke-based, 24x24 grid, inherits `currentColor`.
 */
type IconName = 'monitor' | 'terminal' | 'palette' | 'server' | 'gamepad' | 'shield';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  monitor:
    '<rect x="2.5" y="4" width="19" height="12.5" rx="2"/><path d="M8.5 20.5h7M12 16.5v4"/>',
  terminal:
    '<rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="m7 9.5 3 2.5-3 2.5M13 15h4"/>',
  palette:
    '<path d="M12 21a9 9 0 1 1 9-9c0 2-1.6 2.5-3 2.5h-1.5a2 2 0 0 0-1.4 3.4A1.6 1.6 0 0 1 12 21Z"/><circle cx="8" cy="10" r="1.1"/><circle cx="12" cy="7.5" r="1.1"/><circle cx="16" cy="10" r="1.1"/>',
  server:
    '<rect x="3" y="3.5" width="18" height="7" rx="2"/><rect x="3" y="13.5" width="18" height="7" rx="2"/><path d="M7 7h.01M7 17h.01"/>',
  gamepad:
    '<path d="M7.5 7h9a4.5 4.5 0 0 1 4.4 5.4l-.8 3.3A2.5 2.5 0 0 1 15.8 17l-1.5-1.7H9.7L8.2 17a2.5 2.5 0 0 1-4.3-1.3l-.8-3.3A4.5 4.5 0 0 1 7.5 7Z"/><path d="M7 10.5v2M6 11.5h2M15.5 11h.01M17.5 12.5h.01"/>',
  shield:
    '<path d="M12 2.8 20 6v6c0 4.6-3.2 8-8 9.3C7.2 20 4 16.6 4 12V6l8-3.2Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
};
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
