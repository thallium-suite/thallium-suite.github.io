---
import { faqs } from '../data/site';
---

<section id="faq" class="section container">
  <div class="section-head">
    <p class="eyebrow">Questions</p>
    <h2 class="section-title">Before you ask</h2>
  </div>

  <ul class="faq-list">
    {faqs.map((f, i) => (
      <li class="faq-item">
        <details open={i === 0}>
          <summary class="faq-q">
            <span>{f.q}</span>
            <span class="faq-marker" aria-hidden="true" />
          </summary>
          <div class="faq-a">
            <p>{f.a}</p>
          </div>
        </details>
      </li>
    ))}
  </ul>
</section>

<style>
  .section-head {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    max-width: 820px;
  }

  .faq-item details {
    background: var(--ink-raised);
    border: 2px solid var(--ink-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .faq-item details[open] {
    border-color: var(--teal);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:hover {
    color: var(--teal);
  }

  .faq-marker {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }

  .faq-marker::before,
  .faq-marker::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 3px;
    background: var(--teal);
    border-radius: var(--radius-pill);
    translate: 0 -50%;
    transition: rotate 0.2s ease;
  }

  .faq-marker::after {
    rotate: 90deg;
  }

  .faq-item details[open] .faq-marker::after {
    rotate: 0deg;
  }

  .faq-a {
    padding: 0 1.35rem 1.35rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 68ch;
  }
</style>
